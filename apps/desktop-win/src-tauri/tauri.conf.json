{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RahyAr AI",
  "version": "3.0.0",
  "identifier": "ai.rahyar.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "رهیار — RahyAr AI",
        "width": 1180,
        "height": 780,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:4310 http://127.0.0.1:11434; style-src 'self' 'unsafe-inline'"
    }
  }
}
