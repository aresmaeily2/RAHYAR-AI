# ─── رهیار AI — متغیرهای محیطی (مقادیر نمونه، غیرمحرمانه) ────
# کپی به .env و پر کردن مقادیر واقعی. .env هرگز به گیت نمی‌رود.

# پایگاه‌داده (SQLite محلی)
# مسیر نسبی نسبت به پوشهٔ prisma/ (محل schema.prisma) حل می‌شود:
#   prisma/ → ../db/custom.db  ⟵  <ریشهٔ پروژه>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# محیط اجرا
NODE_ENV=development

# اعتماد به سرآیندهای پروکسی (Caddy → Next):
# پیش‌فرض امن 0 (GU2-SEC4). فقط وقتی پشت Caddy/پروکسی مورد اعتماد هستید 1 بگذارید؛
# در غیر این صورت هر کلاینت با X-Forwarded-For جعلی سقف نرخ را دور می‌زند.
TRUST_PROXY_HEADERS=0

# ── AI Gateway (بخش ۶ دستور) ────────────────────────────────
# کلید قطع اضطراری فراخوانی مدل: 1 = همه فراخوانی‌های مدل بلاک می‌شوند
RAHYAR_AI_DISABLED=0
# سقف‌های مصرف (۰ = بی‌سقف — توصیه نمی‌شود)
AI_USER_DAILY_LIMIT=60
AI_USER_MONTHLY_LIMIT=900
AI_SYSTEM_DAILY_LIMIT=300
# سقف طول ورودی/خروجی هر فراخوانی (نویسه)
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_CHARS=4000

# ── کلید ارائه‌دهنده مدل (فقط سرور؛ نمونه جایگزین) ───────────
# هر کلید واقعی را اینجا قرار ندهید؛ این فایل الگوی نام‌گذاری است.
# MODEL_API_KEY=

# ── راه‌اندازی اولیه (GU2-SEC1) ──────────────────────────────
# در تولید الزامی برای نصب تازه: کدی تصادفی و طولانی (مثلاً `openssl rand -hex 24`).
# فقط کسی که این کد را دارد می‌تواند حساب مالک را بسازد.
RAHYAR_SETUP_TOKEN=
# فقط برای استقرار کاملاً محلی/پشت VPN: راه‌اندازی بدون کد (توصیه نمی‌شود)
RAHYAR_ALLOW_OPEN_SETUP=0

# ── Endpoint سازگار با OpenAI (GU2-SEC3) ─────────────────────
# 1 (پیش‌فرض) = اجازه به localhost/شبکه خصوصی برای Ollama/LM Studio محلی
# 0 = فقط آدرس‌های عمومی (برای استقرار عمومی چندکاربره). متادیتای ابری همیشه مسدود است.
AI_ALLOW_PRIVATE_ENDPOINTS=1
