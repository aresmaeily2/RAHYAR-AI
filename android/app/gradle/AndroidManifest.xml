<?xml version="1.0" encoding="utf-8"?>
<!-- رهیار v2.1.0 — معماری «محلی-اول»:
     ورود اصلی اپ همیشه رابط محلی آفلاین است (۱۰۰٪ بدون سرور، بدون شبکه).
     اتصال به سرور مالک یک «ماژول اختیاری» است که فقط از تنظیمات در دسترس است.
     این تغییر ریشهٔ پیام خطای «سرور اشتباه است» را برمی‌دارد: اپ دیگر در
     شروع، ورود یا استفادهٔ محلی هیچ اجباری به آدرس سرور ندارد. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
>

    <!-- اینترنت: فقط برای ماژول اختیاری «اتصال به سرور» استفاده می‌شود -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- اعلان یادآور سیستمی (اندروید ۱۳+؛ فقط با رضایت صریح کاربر درون اپ) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- زنگ دقیق یادآور (اندروید ۱۲+؛ در نبود مجوز → زمان‌بندی تقریبی) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- باززمان‌بندی یادآورها پس از ری‌استارت دستگاه (از ذخیرهٔ محلی — بدون شبکه) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- لرزش اعلان یادآور -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Rahyar"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- ورودی اصلی: حالت محلی — بدون سرور، بدون حساب، بدون شبکه -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ماژول اختیاری: اتصال به سرور مالک (فقط از تنظیمات حالت محلی باز می‌شود) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- نمای متصل: WebView محصول کامل وب روی سرورِ ثبت‌شدهٔ کاربر -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />

        <!-- گیرندهٔ هشدار یادآور در زمان مقرر (اعلان سیستمی) -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- باززمان‌بندی پس از بوت (از ذخیرهٔ محلی آخرین همگام‌سازی) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
