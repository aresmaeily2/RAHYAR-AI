<?xml version="1.0" encoding="utf-8"?>
<!-- ترافیک cleartext به‌طور کامل بسته است — فقط https. هیچ دامنه‌ای استثنا نیست. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
